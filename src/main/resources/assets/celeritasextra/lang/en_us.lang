# Detail Options
celeritasextra.option.details.sky=Sky
celeritasextra.option.details.sky.tooltip=If enabled, the sky will be rendered.
celeritasextra.option.details.stars=Stars
celeritasextra.option.details.stars.tooltip=If enabled, the stars will be rendered.
celeritasextra.option.details.total_stars=Total Stars
celeritasextra.option.details.total_stars.tooltip=Controls the number of stars rendered in the sky. Requires renderer reload to take effect.
celeritasextra.option.details.sun_moon=Sun & Moon
celeritasextra.option.details.sun_moon.tooltip=If enabled, the sun and moon will be rendered.
celeritasextra.option.details.rain_snow=Rain & Snow
celeritasextra.option.details.rain_snow.tooltip=If enabled, rain & snow are rendered.
celeritasextra.option.details.biome_colors=Biome Colors
celeritasextra.option.details.biome_colors.tooltip=If enabled, biome colors are changed based on the biome.
celeritasextra.option.details.sky_colors=Sky Colors
celeritasextra.option.details.sky_colors.tooltip=Applies biome-based sky coloring.
celeritasextra.option.details.void_fog=Void Fog
celeritasextra.option.details.void_fog.tooltip=If enabled, void fog is rendered below the world.

# Render Options
celeritasextra.option.render.fog=Fog
celeritasextra.option.render.fog.tooltip=If enabled, fog will be rendered.
celeritasextra.option.render.fog_start=Fog Start Multiplier
celeritasextra.option.render.fog_start.tooltip=Adjusts when the terrain fog begins to render for the player.
celeritasextra.option.render.fog_distance=Fog Distance
celeritasextra.option.render.fog_distance.tooltip=Controls the fog render distance in chunks. 0 = Default (uses render distance).
celeritasextra.option.render.prevent_shaders=Prevent Shaders
celeritasextra.option.render.prevent_shaders.tooltip=If enabled, any type of vanilla shaders will be prevented from loading. For example, the distorted view when spectating from a spider's point of view.
celeritasextra.option.render.clouds=Clouds
celeritasextra.option.render.clouds.tooltip=If enabled, clouds are rendered.
celeritasextra.option.render.modern_clouds=Modern Clouds
celeritasextra.option.render.modern_clouds.tooltip=Uses the Minecraft 1.21.6 cloud texture with the existing renderer. AssetMover 2.5 downloads the texture. Keeps cloud height, distance, and scale settings; user resource packs take priority. Applying this option reloads resources.
celeritasextra.option.render.cloud_height=Cloud Height
celeritasextra.option.render.cloud_height.tooltip=Controls the height of clouds that are rendered.
celeritasextra.option.render.cloud_distance=Cloud Distance
celeritasextra.option.render.cloud_distance.tooltip=Controls the cloud render distance in chunks. 0 = Default (uses game render distance).
celeritasextra.option.render.cloud_scale=Cloud Scale
celeritasextra.option.render.cloud_scale.tooltip=Controls the size of clouds from 0.25x to 4.00x. 1.00x is the vanilla default.
celeritasextra.option.render.cloud_translucency=Cloud Translucency
celeritasextra.option.render.cloud_translucency.tooltip=Controls when clouds become translucent. Default: based on cloud height. Always: clouds are always translucent. Never: clouds are always opaque.
celeritasextra.option.cloud_translucency.default=Default
celeritasextra.option.cloud_translucency.always=Always
celeritasextra.option.cloud_translucency.never=Never
celeritasextra.option.render.light_updates=Light Updates
celeritasextra.option.render.light_updates.tooltip=If disabled, light updates will not be processed. This can improve performance but may cause visual artifacts.
celeritasextra.option.render.item_frames=Item Frames
celeritasextra.option.render.item_frames.tooltip=If enabled, item frames are rendered.
celeritasextra.option.render.item_frame_lod_distance=Item Frame LOD Distance
celeritasextra.option.render.item_frame_lod_distance.tooltip=Beyond this distance (in blocks), non-block items retain their front face instead of sprite edges. Maps and 3D blocks stay visible. 0 = Off.
celeritasextra.option.render.armor_stands=Armor Stands
celeritasextra.option.render.armor_stands.tooltip=If enabled, armor stands are rendered.
celeritasextra.option.render.paintings=Paintings
celeritasextra.option.render.paintings.tooltip=If enabled, paintings are rendered.
celeritasextra.option.render.pistons=Pistons
celeritasextra.option.render.pistons.tooltip=If enabled, piston extending animations are rendered.
celeritasextra.option.render.beacons=Beacon Beam
celeritasextra.option.render.beacons.tooltip=If enabled, beacon beams are rendered.
celeritasextra.option.render.limit_beacon_beam_height=Limit Beacon Beam Height
celeritasextra.option.render.limit_beacon_beam_height.tooltip=If enabled, beacon beams will be limited to the maximum height of the world.
celeritasextra.option.render.enchanting_books=Enchanting Table Book
celeritasextra.option.render.enchanting_books.tooltip=If enabled, enchanting table books are rendered.
celeritasextra.option.render.player_name_tag=Player Name Tag
celeritasextra.option.render.player_name_tag.tooltip=If enabled, player name tags will be visible.
celeritasextra.option.render.item_frame_name_tag=Item Frame Name Tag
celeritasextra.option.render.item_frame_name_tag.tooltip=If enabled, item frame name tags will be visible.

# Extra Options
celeritasextra.option.extra.fps=Show FPS
celeritasextra.option.extra.fps.tooltip=Displays the current FPS of the game on the overlay.
celeritasextra.option.extra.fps_extended=Show FPS Extended
celeritasextra.option.extra.fps_extended.tooltip=Displays additional information (average, 1%% low, and 0.1%% low FPS) alongside current FPS on the overlay.
celeritasextra.option.extra.coords=Show Coordinates
celeritasextra.option.extra.coords.tooltip=Displays player coordinates on the overlay.
celeritasextra.option.extra.memory=Show Memory Usage
celeritasextra.option.extra.memory.tooltip=Displays JVM heap usage as a percentage and used/max MiB.
celeritasextra.option.extra.ignore_reduced_debug_info=Ignore Reduced Debug Info
celeritasextra.option.extra.ignore_reduced_debug_info.tooltip=If enabled, coordinates will be shown even when reduced debug info is active (e.g., on servers with reducedDebugInfo gamerule).
celeritasextra.option.extra.overlay_corner=Overlay Corner
celeritasextra.option.extra.overlay_corner.tooltip=Determines in which corner of the screen the overlay (FPS, coordinates, and memory usage) will be rendered.
celeritasextra.option.extra.text_contrast=Text Contrast
celeritasextra.option.extra.text_contrast.tooltip=Adjusts overlay text contrast. None: Plain white text. Background: Text with a debug-style background. Shadow: White text with shadow.
celeritasextra.option.extra.vertical_sync=VSync
celeritasextra.option.extra.vertical_sync.tooltip=Controls vertical synchronization mode. Off: VSync disabled, may cause screen tearing. On: Standard VSync, limits FPS to refresh rate. Adaptive: Enables VSync when above refresh rate, disables when below to reduce stuttering. Only available if supported by GPU driver.
celeritasextra.option.screen_mode=Screen Mode
celeritasextra.option.screen_mode.tooltip=Windowed: Standard window mode. Borderless: Fullscreen without exclusive mode, allows easy alt-tab and multi-monitor use. Fullscreen: Exclusive fullscreen mode.
celeritasextra.option.screen_mode.windowed=Windowed
celeritasextra.option.screen_mode.borderless=Borderless
celeritasextra.option.screen_mode.fullscreen=Fullscreen
celeritasextra.option.extra.mod_name_tooltip=Mod Name Tooltip
celeritasextra.option.extra.mod_name_tooltip.tooltip=Shows the source mod’s name at the bottom of every item’s tooltip.
celeritasextra.option.extra.steady_debug_hud=Steady Debug Hud
celeritasextra.option.extra.steady_debug_hud.tooltip=If enabled, the debug hud will be refreshed every set number of ticks, configured by the Steady Debug Hud Refresh Interval.
celeritasextra.option.extra.steady_debug_hud_refresh=Steady Debug Hud Refresh Interval
celeritasextra.option.extra.steady_debug_hud_refresh.tooltip=Adjusts the interval, in ticks, at which the debug hud is refreshed.
celeritasextra.option.extra.toasts=Toasts
celeritasextra.option.extra.toasts.tooltip=Shows advancement and recipe popups (toasts).
celeritasextra.option.extra.toast_advancement=Advancement Toasts
celeritasextra.option.extra.toast_advancement.tooltip=Shows advancement popups (toasts).
celeritasextra.option.extra.toast_recipe=Recipe Toasts
celeritasextra.option.extra.toast_recipe.tooltip=Shows recipe popups (toasts).
celeritasextra.option.extra.toast_tutorial=Tutorial Toasts
celeritasextra.option.extra.toast_tutorial.tooltip=Shows tutorial popups (toasts).
celeritasextra.option.extra.toast_system=System Toasts
celeritasextra.option.extra.toast_system.tooltip=Shows system popups (toasts).

