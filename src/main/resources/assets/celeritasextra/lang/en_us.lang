# Render Options
sodium-extra.option.fog_type.atmospheric=Atmospheric Fog
sodium-extra.option.fog_type.atmospheric.tooltip=Controls fog caused by atmosphere and weather.
sodium-extra.option.fog_start=Fog Start
sodium-extra.option.fog_start.tooltip=Controls how close to the player atmospheric terrain fog begins.
sodium-extra.option.fog_distance=Fog Distance
sodium-extra.option.fog_distance.tooltip=Controls the fog render distance in chunks. 0 = Default (uses render distance).
sodium-extra.option.prevent_shaders=Prevent Shaders
sodium-extra.option.prevent_shaders.tooltip=Prevents vanilla shader effects from loading (e.g., spider-view distortion while spectating).
celeritasextra.option.clouds.tooltip=If enabled, clouds are rendered.
celeritasextra.option.modern_clouds=Modern Clouds
celeritasextra.option.modern_clouds.tooltip=Uses the Minecraft 1.21.6 cloud texture with the existing renderer. AssetMover 2.5 downloads the texture. Keeps cloud height, distance, and scale settings. While enabled, overrides cloud textures from resource packs. Applying this option reloads resources.
sodium-extra.option.cloud_height=Cloud Height
sodium-extra.option.cloud_height.tooltip=Controls the height of clouds that are rendered.
sodium-extra.option.cloud_distance=Cloud Distance
sodium-extra.option.cloud_distance.tooltip=Controls the cloud render distance in chunks. 0 = Default (uses game render distance).
options.cloud_scale=Cloud Scale
options.cloud_scale.tooltip=Controls the size of clouds from 0.25x to 4.00x. 1.00x is the vanilla default.
options.mode_cloud_translucency=Cloud Translucency
options.mode_cloud_translucency.tooltip=Controls when clouds become translucent. Default: based on cloud height. Always: clouds are always translucent. Never: clouds are always opaque.
celeritasextra.option.cloud_translucency.default=Default
celeritasextra.option.cloud_translucency.always=Always
celeritasextra.option.cloud_translucency.never=Never
sodium-extra.option.light_updates=Light Updates
sodium-extra.option.light_updates.tooltip=Processes lighting updates. Disabling this may cause incorrect lighting when generating chunks. Only disable if you understand the impact.
sodium-extra.option.item_frames.tooltip=Renders item frames.
moreculling.config.option.itemFrameLODRange=Frame LOD Range
moreculling.config.option.itemFrameLODRange.tooltip=Beyond this distance (in blocks), non-block items retain their front face instead of sprite edges. Maps and 3D blocks stay visible. 0 = Off.
sodium-extra.option.armor_stands.tooltip=Renders armor stands.
sodium-extra.option.paintings.tooltip=Renders paintings.
sodium-extra.option.piston.tooltip=Renders piston extension animations.
sodium-extra.option.beacon_beam=Beacon Beam
sodium-extra.option.beacon_beam.tooltip=Renders beacon beams.
sodium-extra.option.limit_beacon_beam_height=Limit Beacon Beam Height
sodium-extra.option.limit_beacon_beam_height.tooltip=Limits beacon beams to the world’s maximum height.
sodium-extra.option.enchanting_table_book=Enchanting Table Book
sodium-extra.option.enchanting_table_book.tooltip=Renders the enchanting table book.
sodium-extra.option.player_name_tag=Player Name Tag
sodium-extra.option.player_name_tag.tooltip=Shows player name tags.
sodium-extra.option.item_frame_name_tag=Item Frame Name Tag
sodium-extra.option.item_frame_name_tag.tooltip=Shows name tags for item frames.

# Extra Options
sodium-extra.option.show_fps=Show FPS
sodium-extra.option.show_fps.tooltip=Shows the current FPS on the overlay.
sodium-extra.option.show_fps_extended=Show FPS Extended
sodium-extra.option.show_fps_extended.tooltip=Displays additional information (average, 1%% low, and 0.1%% low FPS) alongside current FPS on the overlay.
sodium-extra.option.show_coordinates=Show Coordinates
sodium-extra.option.show_coordinates.tooltip=Shows player coordinates on the overlay.
celeritasextra.option.show_memory=Show Memory Usage
celeritasextra.option.show_memory.tooltip=Displays JVM heap usage as a percentage and used/max MiB.
celeritasextra.option.ignore_reduced_debug_info=Ignore Reduced Debug Info
celeritasextra.option.ignore_reduced_debug_info.tooltip=If enabled, coordinates will be shown even when reduced debug info is active (e.g., on servers with reducedDebugInfo gamerule).
sodium-extra.option.overlay_corner=Overlay Corner
sodium-extra.option.overlay_corner.tooltip=Determines in which corner of the screen the overlay (FPS, coordinates, and memory usage) will be rendered.
sodium-extra.option.text_contrast=Text Contrast
sodium-extra.option.text_contrast.tooltip=Adjusts overlay text contrast. None: Plain white text. Background: Text with a debug-style background. Shadow: White text with shadow.
celeritasextra.option.vsync.tooltip=Controls vertical synchronization mode. Off: VSync disabled, may cause screen tearing. On: Standard VSync, limits FPS to refresh rate. Adaptive: Enables VSync when above refresh rate, disables when below to reduce stuttering. Only available if supported by GPU driver.
sodium.extras.options.screen.title=Fullscreen Mode
sodium.extras.options.screen.desc=Windowed: Standard window mode. Borderless: Fullscreen without exclusive mode, allows easy alt-tab and multi-monitor use. Fullscreen: Exclusive fullscreen mode.
sodium.extras.options.screen.windowed=Windowed
sodium.extras.options.screen.borderless=Borderless
celeritasextra.option.mod_name_tooltip=Mod Name Tooltip
celeritasextra.option.mod_name_tooltip.tooltip=Shows the source mod’s name at the bottom of every item’s tooltip.
sodium-extra.option.steady_debug_hud=Steady Debug HUD
sodium-extra.option.steady_debug_hud.tooltip=Refreshes the debug HUD at a fixed interval set by Steady Debug HUD Refresh Interval.
sodium-extra.option.steady_debug_hud_refresh_interval=Steady Debug HUD Refresh Interval
sodium-extra.option.steady_debug_hud_refresh_interval.tooltip=Sets how often the debug HUD refreshes (in ticks).
sodium-extra.option.toasts=Toasts
sodium-extra.option.toasts.tooltip=Shows advancement and recipe popups (toasts).
sodium-extra.option.advancement_toast=Advancement Toasts
sodium-extra.option.advancement_toast.tooltip=Shows advancement popups (toasts).
sodium-extra.option.recipe_toast=Recipe Toasts
sodium-extra.option.recipe_toast.tooltip=Shows recipe popups (toasts).
sodium-extra.option.tutorial_toast=Tutorial Toasts
sodium-extra.option.tutorial_toast.tooltip=Shows tutorial popups (toasts).
sodium-extra.option.system_toast=System Toasts
sodium-extra.option.system_toast.tooltip=Shows system popups (toasts).

