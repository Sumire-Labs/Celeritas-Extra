sodium-extra.option.sun=Sun
sodium-extra.option.sun.tooltip=Renders the sun.
sodium-extra.option.moon=Moon
sodium-extra.option.moon.tooltip=Renders the moon.
moreculling.config.option.signTextCulling=Sign Text Culling
moreculling.config.option.signTextCulling.tooltip=Skips sign text viewed from behind. Editing and near-plane views remain visible.
moreculling.config.option.itemFrameMapCulling=Frame Map Culling
moreculling.config.option.itemFrameMapCulling.tooltip=Skips framed maps viewed from behind. Maps stay visible from the front at any distance.
celeritasextra.option.entity_render_distance=Entity Render Distance
celeritasextra.option.entity_render_distance.tooltip=Limits entity rendering distance in blocks. 0 keeps vanilla behavior. Exempt classes can be configured in the config file.
celeritasextra.option.tile_entity_render_distance=Tile Entity Render Distance
celeritasextra.option.tile_entity_render_distance.tooltip=Limits special block renderer distance in blocks. 0 keeps vanilla behavior. Beacons are exempt by default; additional classes can be configured.
celeritasextra.option.inactive_fps_limit=Unfocused FPS Limit
celeritasextra.option.inactive_fps_limit.tooltip=Limits drawing while the window is unfocused. 0 = Off. Client ticks and network processing continue at 20 Hz or more.
celeritasextra.option.minimized_fps_limit=Minimized FPS Limit
celeritasextra.option.minimized_fps_limit.tooltip=Limits drawing while the window is minimized. 0 inherits the unfocused limit.
celeritasextra.option.dimension_fog_override=Override Fog: %s
celeritasextra.option.dimension_fog_override.tooltip=Use separate atmospheric fog settings for this dimension. Disabled inherits the global settings. Blindness, water, and lava fog are preserved.
celeritasextra.option.particle_spawn_percentage.tooltip=Sets the spawn percentage for %s. 0%% = Off, 100%% = all particles.

