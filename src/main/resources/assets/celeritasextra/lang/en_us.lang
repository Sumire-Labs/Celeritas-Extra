celeritasextra.option.details.sun=Sun
celeritasextra.option.details.sun.tooltip=Render the sun independently of the moon.
celeritasextra.option.details.moon=Moon
celeritasextra.option.details.moon.tooltip=Render the moon independently of the sun.
celeritasextra.option.render.sign_text_culling=Cull Sign Text
celeritasextra.option.render.sign_text_culling.tooltip=Skips sign text viewed from behind. Editing and near-plane views remain visible.
celeritasextra.option.render.map_back_face_culling=Cull Map Back Faces
celeritasextra.option.render.map_back_face_culling.tooltip=Skips framed maps viewed from behind. Maps stay visible from the front at any distance.
celeritasextra.option.render.entity_distance=Entity Render Distance
celeritasextra.option.render.entity_distance.tooltip=Limits entity rendering distance in blocks. 0 keeps vanilla behavior. Exempt classes can be configured in the config file.
celeritasextra.option.render.tile_entity_distance=Tile Entity Render Distance
celeritasextra.option.render.tile_entity_distance.tooltip=Limits special block renderer distance in blocks. 0 keeps vanilla behavior. Beacons are exempt by default; additional classes can be configured.
celeritasextra.option.extra.inactive_fps=Unfocused FPS Limit
celeritasextra.option.extra.inactive_fps.tooltip=Limits drawing while the window is unfocused. 0 = Off. Client ticks and network processing continue at 20 Hz or more.
celeritasextra.option.extra.minimized_fps=Minimized FPS Limit
celeritasextra.option.extra.minimized_fps.tooltip=Limits drawing while the window is minimized. 0 inherits the unfocused limit.
celeritasextra.option.render.dimension_fog=Override Fog: %s
celeritasextra.option.render.dimension_fog.tooltip=Use separate atmospheric fog settings for this dimension. Disabled inherits the global settings. Blindness, water, and lava fog are preserved.
celeritasextra.option.particles.spawn_rate.tooltip=Sets the spawn percentage for %s. 0%% = Off, 100%% = all particles.

